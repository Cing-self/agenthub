{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agenthub-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-04-03",
  "durable_objects": {
    "bindings": [
      {
        "name": "HOST_ROOM",
        "class_name": "HostRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "HostRoom"
      ]
    }
  ]
}
